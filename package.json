{
  "name": "campusos-city-university",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/migrate-deploy.mjs",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "uploads:cleanup": "tsx scripts/cleanup-orphan-uploads.ts",
    "reminders:send": "tsx scripts/send-reminders.ts",
    "analyze": "next analyze",
    "test:e2e": "playwright test",
    "db:explain": "tsx scripts/explain-queries.ts",
    "audit:prod": "npm audit --omit=dev",
    "docs:verify-db": "tsx scripts/verify-db-doc.ts",
    "docs:verify-readme": "tsx scripts/verify-readme.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-slot": "1.4.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@types/node": "24.19.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@uploadthing/react": "7.3.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "14.0.0",
    "image-video-compressor": "1.0.0",
    "jose": "6.2.12",
    "jsqr": "1.4.0",
    "lucide-react": "1.52.0",
    "nanoid": "6.0.2",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "prisma": "7.10.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-hot-toast": "2.6.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "uploadthing": "7.7.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "sharp@0.35.5": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "image-video-compressor": {
      "sharp": "$sharp"
    },
    "effect": "3.20.0",
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2"
  }
}
